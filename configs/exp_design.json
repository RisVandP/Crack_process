{
  "note": "实验设计总配置。这里的rate、level、pattern等只用于生成确定性输入，不作为算法读取的模型参数。",
  "algorithms": ["ValueFirst", "ValueDensityFirst", "MarginalGreedy", "CNAG-LS"],
  "seeds": {
    "baseline": [2026, 2027, 2028, 2029, 2030, 2031, 2032, 2033, 2034, 2035],
    "small_exact": [3101, 3102, 3103, 3104, 3105],
    "stress": [4101, 4102, 4103, 4104, 4105]
  },
  "base": {
    "board": {
      "width": 10.0,
      "height": 10.0,
      "m": 10,
      "n": 10,
      "base_value": 100.0
    },
    "devices": [
      {"id": "O1", "type": "ordinary", "speed": 0.9},
      {"id": "O2", "type": "ordinary", "speed": 1.1},
      {"id": "P1", "type": "precision", "speed": 0.8},
      {"id": "P2", "type": "precision", "speed": 1.2}
    ],
    "deadline": 18.0,
    "values": {
      "r_ordinary": 1.0,
      "r_precision": 1.6,
      "default_same_precision_reward": 0.3,
      "default_precision_mismatch_penalty": 0.3,
      "default_cross_crack_loss": 0.15,
      "alpha": 1.0
    },
    "crack_gen": {
      "mode": "block",
      "rate": 0.25,
      "cs_range": [0.2, 0.8],
      "pattern": "random",
      "cross_edge_rate": 0.08
    }
  },
  "E0_exact_check": {
    "purpose": "正确性与小规模精确验证",
    "sizes": [
      {"id": "G1_2x2", "m": 2, "n": 2},
      {"id": "G2_2x3", "m": 2, "n": 3},
      {"id": "G3_3x3", "m": 3, "n": 3}
    ],
    "device_template": [
      {"id": "O1", "type": "ordinary", "speed": 1.0},
      {"id": "P1", "type": "precision", "speed": 0.9}
    ],
      "deadline_rule": "calibrate_common_deadline_to_processed_ratio_50_to_70_percent"
  },
  "E1_baseline": {
    "purpose": "基准实例四算法比较",
    "base_config": "base",
    "seeds": "baseline",
    "calibration_targets": {
      "processed_ratio": [0.5, 0.7],
      "require_ordinary_and_precision_used": true,
      "require_nonzero_adjacency_value": true
    }
  },
  "E2_one_factor_gradients": {
    "purpose": "单因素参数梯度实验",
    "size": [
      {"level": "G1", "m": 2, "n": 2, "usage": "exact_check"},
      {"level": "G2", "m": 4, "n": 4, "usage": "small"},
      {"level": "G3", "m": 6, "n": 6, "usage": "mid_small"},
      {"level": "G4", "m": 10, "n": 10, "usage": "baseline"},
      {"level": "G5", "m": 15, "n": 15, "usage": "large"},
      {"level": "G6", "m": 20, "n": 20, "usage": "stress"}
    ],
    "crack_severity": [
      {"level": "C0", "cs_range": [0.0, 0.0]},
      {"level": "C1", "cs_range": [0.10, 0.25]},
      {"level": "C2", "cs_range": [0.25, 0.50]},
      {"level": "C3", "cs_range": [0.50, 0.75]},
      {"level": "C4", "cs_range": [0.75, 1.00]}
    ],
    "alpha": [
      {"level": "A0", "alpha": 0.0},
      {"level": "A1", "alpha": 0.5},
      {"level": "A2", "alpha": 1.0},
      {"level": "A3", "alpha": 1.5},
      {"level": "A4", "alpha": 2.0}
    ],
    "device_speed": [
      {"level": "S0", "ordinary": [1.0, 1.0], "precision": [1.0, 1.0]},
      {"level": "S1", "ordinary": [0.9, 1.1], "precision": [0.9, 1.1]},
      {"level": "S2", "ordinary": [0.7, 1.3], "precision": [0.8, 1.2]},
      {"level": "S3", "ordinary": [0.5, 1.5], "precision": [0.6, 1.4]},
      {"level": "S4", "ordinary": [0.4, 1.8], "precision": [0.5, 1.7]}
    ],
    "time_capacity": [
      {"level": "T0", "total_capacity_factor": 1.20},
      {"level": "T1", "total_capacity_factor": 0.90},
      {"level": "T2", "total_capacity_factor": 0.70},
      {"level": "T3", "total_capacity_factor": 0.50},
      {"level": "T4", "total_capacity_factor": 0.30}
    ],
    "processing_value": [
      {"level": "R0", "r_ordinary": 1.0, "r_precision": 1.0},
      {"level": "R1", "r_ordinary": 1.0, "r_precision": 1.2},
      {"level": "R2", "r_ordinary": 1.0, "r_precision": 1.5},
      {"level": "R3", "r_ordinary": 1.0, "r_precision": 2.0},
      {"level": "R4", "r_ordinary": 1.0, "r_precision": 3.0}
    ],
    "same_precision_reward": [
      {"level": "B0", "b": 0.0},
      {"level": "B1", "b": 0.1},
      {"level": "B2", "b": 0.3},
      {"level": "B3", "b": 0.6},
      {"level": "B4", "b": 1.0}
    ],
    "mismatch_penalty": [
      {"level": "P0", "p": 0.0},
      {"level": "P1", "p": 0.1},
      {"level": "P2", "p": 0.3},
      {"level": "P3", "p": 0.6},
      {"level": "P4", "p": 1.0}
    ]
  },
  "E3_crack_spatial_patterns": [
    {"id": "D1", "name": "uniform_sparse", "pattern": "dispersed", "target_crack_rate": 0.25, "target_cs_range": [0.2, 0.8]},
    {"id": "D2", "name": "random", "pattern": "random", "target_crack_rate": 0.25, "target_cs_range": [0.2, 0.8]},
    {"id": "D3", "name": "clustered", "pattern": "cluster", "target_crack_rate": 0.25, "target_cs_range": [0.2, 0.8]},
    {"id": "D4", "name": "boundary_crossing", "pattern": "band_crossing_edges", "target_crack_rate": 0.25, "target_cs_range": [0.2, 0.8], "cross_edge_rate": 0.18},
    {"id": "D5", "name": "high_value_zone", "pattern": "high_value_zone", "target_crack_rate": 0.25, "target_cs_range": [0.2, 0.8]}
  ],
  "E4_integrated_cases": [
    {"id": "M1", "name": "simple_loose", "size": "G2", "crack": "C1_random", "speed": "S0", "time": "T1", "value": "R2", "adj": "weak"},
    {"id": "M2", "name": "capacity_competition", "size": "G4", "crack": "C2_random", "speed": "S2", "time": "T3", "value": "R2", "adj": "mid"},
    {"id": "M3", "name": "crack_time_dominant", "size": "G4", "crack": "C4_cluster", "speed": "S2", "time": "T2", "value": "R2", "adj": "mid"},
    {"id": "M4", "name": "device_heterogeneity", "size": "G4", "crack": "C2_random", "speed": "S3", "time": "T2", "value": "R2", "adj": "mid"},
    {"id": "M5", "name": "strong_adjacency", "size": "G4", "crack": "C2_cluster", "speed": "S2", "time": "T2", "value": "R2", "adj": "strong"},
    {"id": "M6", "name": "precision_scarce", "size": "G4", "crack": "C2_random", "speed": "precision_scarce", "time": "T2", "value": "R4", "adj": "mid_high"},
    {"id": "M7", "name": "large_pressure", "size": "G5", "crack": "C3_random", "speed": "S3", "time": "T3", "value": "R2", "adj": "mid_high"},
    {"id": "M8", "name": "extreme_complex", "size": "G6", "crack": "C4_cluster", "speed": "S4", "time": "T4", "value": "R4", "adj": "strong"}
  ],
  "E5_stress_tests": {
    "known_complex_rerun": true,
    "post_solution_stress": true,
    "failure_levels": [
      {"level": "F0", "change": "none"},
      {"level": "F1", "speed_multiplier": {"one_device": 0.90}},
      {"level": "F2", "speed_multiplier": {"one_device": 0.70}},
      {"level": "F3", "speed_multiplier": {"two_devices": 0.70}},
      {"level": "F4", "remove_device": "one_ordinary"},
      {"level": "F5", "remove_device": "one_precision", "speed_multiplier": {"another_precision": 0.80}}
    ],
    "hidden_crack_levels": [
      {"level": "H0", "new_crack_rate": 0.00, "cs_range": [0.0, 0.0], "pattern": "none"},
      {"level": "H1", "new_crack_rate": 0.05, "cs_range": [0.1, 0.3], "pattern": "random"},
      {"level": "H2", "new_crack_rate": 0.12, "cs_range": [0.3, 0.6], "pattern": "random"},
      {"level": "H3", "new_crack_rate": 0.20, "cs_range": [0.5, 0.8], "pattern": "random"},
      {"level": "H4", "new_crack_rate": 0.25, "cs_range": [0.7, 1.0], "pattern": "cluster", "cross_edge_rate": 0.20}
    ]
  },
  "report_metrics": [
    "objective_total",
    "objective_decision",
    "processing_value",
    "adjacency_value",
    "runtime_s",
    "processed_count",
    "precision_count",
    "mean_utilization",
    "max_utilization",
    "feasible",
    "exact_gap",
    "stress_overloaded_machine_count",
    "stress_total_overtime",
    "stress_value_drop_ratio"
  ]
}
